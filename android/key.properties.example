# Copy this file to key.properties and replace the placeholders with your real values.
# Keep key.properties and the keystore private; never commit or share them.
# The upload keystore certificate must have this SHA1:
# 25:F9:2E:13:25:A1:BC:58:33:01:88:DF:59:D5:F4:E7:07:A3:32:F8
# A relative storeFile path is resolved from the android/ directory.
# The project keystore is kept at the repository root.
storeFile=../upload-keystore.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=REPLACE_WITH_KEY_PASSWORD